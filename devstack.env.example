# Copy to devstack.env and adjust. Values set in the environment (make up OPENSLICE=local) win.

# Unique per developer: it names the k3d cluster and, with OPENSLICE=ice, this cluster in
# the shared OpenSlice catalog.
#CLUSTER_NAME=cop1-yourname

# none: ColonyOS + Kolony only. local: also run OpenSlice on this machine.
# ice: connect this cluster to the shared Cluster 1 OpenSlice at RISE ICE.
#OPENSLICE=none

#COLONY_NAME=dev
#LOCATION_NAME=devstack
#COLONIES_HOST_PORT=50080
#API_HOST_PORT=6550

# OPENSLICE=local: the one URL of the portal and APIs, for browsers, peers and pods (README,
# "Connecting the devstack's OpenSlice to the platform"). Its port is published on
# OPENSLICE_BIND, which defaults to the URL's address when that is an IPv4 address, else to
# 127.0.0.1.
#OPENSLICE_URL=http://openslice.localhost:8090
#OPENSLICE_BIND=127.0.0.1

# OPENSLICE=ice: what the ICE OpenSlice admins give you (README, "ice").
#OSL_ICE_URL=http://<ice-openslice-host>
#OSL_USER=<your OpenSlice account>
#OSL_PASSWORD=<its password>
#OSL_BROKER_USER=<broker user>
#OSL_BROKER_PASSWORD=<broker password>
#OSL_ICE_ZITI_IDENTITY=/path/to/enrolled-identity.json

# Custom resources of your own operator that CRIDGE may create for OpenSlice orders
# (README, "Your own Kubernetes operator"), as <plural>.<group>, space-separated.
#CRIDGE_RESOURCES=widgets.example.com

# Pull the cluster's images through caches that survive 'make down' (scripts/cache.sh).
#IMAGE_CACHE=on

# Build Kolony from a local checkout instead of KOLONY_GIT@KOLONY_REF (versions.env).
#KOLONY_SRC=../kolony

# Colima on macOS: k3d and the other tools may not follow Colima's Docker context, so point the
# scripts at the VM's socket (adjust the profile name). Docker on Linux needs nothing here.
#export DOCKER_HOST=unix://$HOME/.colima/default/docker.sock
