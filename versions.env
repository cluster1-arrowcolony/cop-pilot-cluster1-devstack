# Pinned versions for every component of the devstack. Change them here only.
# Kolony's Go client must match COLONIES_VERSION; scripts/kolony.sh warns when its go.mod differs.

K3D_VERSION=v5.9.0
# Same minor as the ICE Cluster 1 k3s. CRIDGE's fabric8 client breaks on v1.33+.
K3S_IMAGE=rancher/k3s:v1.31.14-k3s1
KUBECTL_VERSION=v1.31.14
HELM_VERSION=v3.22.0

COLONIES_VERSION=v1.9.10
TIMESCALEDB_IMAGE=timescale/timescaledb:2.24.0-pg17
DOCKER_RECONCILER_IMAGE=colonyos/docker-reconciler:v1.0.10

# Kolony is built from source so the operator always matches COLONIES_VERSION.
# The devstack branch of the fork carries the changes listed in README.md until upstream has them.
# KOLONY_REF pins a commit of that branch, so every checkout builds the same operator; move it
# when the branch gets new commits. A branch or tag name works too, e.g. KOLONY_REF=devstack.
KOLONY_GIT=https://github.com/nvt/kolony.git
KOLONY_REF=7ba8c0e1dc93ed8c3b4fa6364963eff7aea95f96

# Pull-through registry caches for the cluster's images (scripts/cache.sh).
REGISTRY_IMAGE=registry:3.0.0

# Used by 'make test'.
ECHO_EXECUTOR_IMAGE=colonyos/echoexecutor:v1.0.8

# OpenSlice release used for OPENSLICE=local, and for the CRIDGE that OPENSLICE=ice runs.
# The ICE instance was built from source in December 2025; 2025Q4 is the matching release.
OPENSLICE_REF=2025Q4
OPENSLICE_GIT=https://labs.etsi.org/rep/osl/code/org.etsi.osl.main.git
OPENSLICE_REGISTRY=labs.etsi.org:5050/osl/code
# Upstream ingress-nginx is retired (2026-03), but the OpenSlice chart targets class "nginx".
INGRESS_NGINX_CHART_VERSION=4.15.1

# ARGOCD=on (scripts/argocd.sh). Argo CD 3.4 is the newest minor tested with Kubernetes v1.32;
# the image tag moves it to a newer patch release than the chart's own.
ARGOCD_CHART_VERSION=10.2.2
ARGOCD_IMAGE_TAG=v3.4.10
# The chart 'make test' orders through Argo CD.
ARGOCD_TEST_REPO=https://stefanprodan.github.io/podinfo
ARGOCD_TEST_CHART=podinfo
ARGOCD_TEST_CHART_VERSION=6.14.1

# OPENSLICE=ice broker tunnels.
ZITI_IMAGE=openziti/ziti-cli:2.0.7
# Base of the ssh tunnel image, which openslice-ice.sh builds locally with openssh-client added.
SSH_TUNNEL_IMAGE=alpine:3.22
